# Contact email system (Resend) — placeholders only, never real secrets.
# Local dev: copy to .env.local and fill in. Vercel: Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Your inbox — receives the visitor's message (Reply-To is the visitor).
CONTACT_EMAIL=

# Verified sender in Resend (domain or single sender). BARE address only,
# e.g. hello@yourdomain.com — the app sends as "Somesh M Portfolio <addr>".
CONTACT_FROM_EMAIL=
